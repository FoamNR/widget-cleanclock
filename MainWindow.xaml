<Window x:Class="widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:widget"
        mc:Ignorable="d"
        Title="Desktop Wallpaper Clock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        MouseWheel="Window_MouseWheel"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#E6181B26"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="12" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" Margin="3"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Context Menu for Quick Customization -->
    <Window.ContextMenu>
        <ContextMenu x:Name="ClockContextMenu">
            <MenuItem Header="🖼️ Display Mode">
                <MenuItem Header="🖼️ Desktop Wallpaper Layer (Bottom-most)" IsCheckable="True" x:Name="MenuModeWallpaper" Click="MenuModeWallpaper_Click"/>
                <MenuItem Header="🔝 Always on Top" IsCheckable="True" x:Name="MenuModeTopmost" Click="MenuModeTopmost_Click"/>
                <MenuItem Header="📌 Normal Window" IsCheckable="True" x:Name="MenuModeNormal" Click="MenuModeNormal_Click"/>
            </MenuItem>

            <MenuItem Header="🔒 Lock Position / Click-Through" x:Name="MenuClickThrough" Click="MenuClickThrough_Click">
                <MenuItem.ToolTip>
                    <ToolTip Content="Allows mouse clicks to pass through to apps behind the clock. Double-click system tray icon to unlock."/>
                </MenuItem.ToolTip>
            </MenuItem>

            <MenuItem Header="🚀 Start with Windows" IsCheckable="True" x:Name="MenuAutoStart" Click="MenuAutoStart_Click"/>

            <Separator/>

            <!-- Color Options -->
            <MenuItem Header="🎨 Text Color">
                <MenuItem Header="⚪ Pure White" Click="MenuColor_Click" Tag="#FFFFFF"/>
                <MenuItem Header="🟡 Warm Ivory" Click="MenuColor_Click" Tag="#FFF7ED"/>
                <MenuItem Header="🔵 Sky Cyan" Click="MenuColor_Click" Tag="#38BDF8"/>
                <MenuItem Header="🟢 Mint Green" Click="MenuColor_Click" Tag="#34D399"/>
                <MenuItem Header="🟠 Sunset Amber" Click="MenuColor_Click" Tag="#F59E0B"/>
                <MenuItem Header="🔴 Pastel Rose" Click="MenuColor_Click" Tag="#FB7185"/>
                <MenuItem Header="🟣 Soft Lavender" Click="MenuColor_Click" Tag="#C084FC"/>
                <MenuItem Header="⚫ Charcoal Dark" Click="MenuColor_Click" Tag="#1E293B"/>
                <Separator/>
                <MenuItem Header="🌈 Custom Color..." Click="MenuCustomColor_Click"/>
            </MenuItem>

            <!-- Size Options -->
            <MenuItem Header="🔍 Text Size / Scale">
                <MenuItem Header="Tiny (70%)" Click="MenuScale_Click" Tag="0.7"/>
                <MenuItem Header="Small (85%)" Click="MenuScale_Click" Tag="0.85"/>
                <MenuItem Header="Normal (100%)" Click="MenuScale_Click" Tag="1.0"/>
                <MenuItem Header="Large (125%)" Click="MenuScale_Click" Tag="1.25"/>
                <MenuItem Header="Extra Large (150%)" Click="MenuScale_Click" Tag="1.5"/>
                <MenuItem Header="Huge (200%)" Click="MenuScale_Click" Tag="2.0"/>
                <Separator/>
                <MenuItem Header="💡 Tip: Scroll mouse wheel on clock to resize anytime" IsEnabled="False"/>
            </MenuItem>

            <!-- Font Weight -->
            <MenuItem Header="🖋️ Font Weight">
                <MenuItem Header="Light" Click="MenuWeight_Click" Tag="Light" x:Name="MenuWeightLight"/>
                <MenuItem Header="Regular" Click="MenuWeight_Click" Tag="Normal" x:Name="MenuWeightNormal"/>
                <MenuItem Header="SemiBold" Click="MenuWeight_Click" Tag="SemiBold" x:Name="MenuWeightSemiBold"/>
            </MenuItem>

            <Separator/>

            <!-- Time Format -->
            <MenuItem Header="⏱ Time Format">
                <MenuItem Header="24-Hour (e.g. 21:47)" IsCheckable="True" x:Name="Menu24Hour" Click="Menu24Hour_Click"/>
                <MenuItem Header="12-Hour (e.g. 09:47 PM)" IsCheckable="True" x:Name="Menu12Hour" Click="Menu12Hour_Click"/>
                <Separator/>
                <MenuItem Header="Show Seconds (:SS)" IsCheckable="True" x:Name="MenuShowSeconds" Click="MenuShowSeconds_Click"/>
            </MenuItem>

            <!-- Date Format -->
            <MenuItem Header="📅 Date Format">
                <MenuItem Header="English Full (Wednesday, 21 September 2026)" IsCheckable="True" x:Name="MenuDateFullEn" Click="MenuDateFullEn_Click"/>
                <MenuItem Header="English Short (Wed, 21 Sep 2026)" IsCheckable="True" x:Name="MenuDateShortEn" Click="MenuDateShortEn_Click"/>
                <MenuItem Header="Thai (วันจันทร์, 26 ตุลาคม 2026)" IsCheckable="True" x:Name="MenuDateTh" Click="MenuDateTh_Click"/>
            </MenuItem>

            <!-- Drop Shadow Toggle -->
            <MenuItem Header="✨ Text Drop Shadow" IsCheckable="True" x:Name="MenuDropShadow" Click="MenuDropShadow_Click"/>

            <Separator/>
            <MenuItem Header="⚙ Reset Position to Top Center" Click="MenuResetPosition_Click"/>
            <MenuItem Header="❌ Exit" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Main Transparent Container (No background box/border) -->
    <!-- Background="#01000000" allows mouse hit-test for dragging anywhere within content -->
    <Grid Margin="24" Background="#01000000" Cursor="SizeAll" ToolTip="Left-click &amp; drag to move | Scroll mouse wheel to resize | Right-click for settings">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="WidgetScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Row 1: Time Display (Large, Clean, No Background) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Main Time (HH:mm) -->
                <TextBlock x:Name="TimeMainText" 
                           Text="21:47" 
                           FontSize="84" 
                           FontWeight="Light" 
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" 
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="TimeShadowEffect" 
                                          Color="#000000" 
                                          BlurRadius="8" 
                                          Opacity="0.45" 
                                          ShadowDepth="2" 
                                          Direction="315"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Seconds (:ss) -->
                <TextBlock x:Name="TimeSecondsText" 
                           Text=":30" 
                           FontSize="40" 
                           FontWeight="Light" 
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" 
                           Foreground="#E2E8F0"
                           VerticalAlignment="Bottom" 
                           Margin="4,0,0,16"
                           Opacity="0.8"
                           Visibility="Collapsed">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" Opacity="0.45" ShadowDepth="1" Direction="315"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- AM / PM Indicator -->
                <TextBlock x:Name="AmPmText" 
                           Text="PM" 
                           FontSize="18" 
                           FontWeight="Normal" 
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           Foreground="#E2E8F0"
                           Margin="8,0,0,20" 
                           VerticalAlignment="Bottom"
                           Opacity="0.75"
                           Visibility="Collapsed">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" Opacity="0.45" ShadowDepth="1" Direction="315"/>
                    </TextBlock.Effect>
                </TextBlock>

            </StackPanel>

            <!-- Row 2: Date Display (Wednesday, 21 September 2026 - Clean, Smaller) -->
            <TextBlock x:Name="DateText" 
                       Text="Wednesday, 21 September 2026" 
                       FontSize="20" 
                       FontWeight="Normal" 
                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" 
                       Foreground="#E2E8F0"
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"
                       Margin="0,-2,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="DateShadowEffect" 
                                      Color="#000000" 
                                      BlurRadius="6" 
                                      Opacity="0.45" 
                                      ShadowDepth="1.5" 
                                      Direction="315"/>
                </TextBlock.Effect>
            </TextBlock>

        </StackPanel>
    </Grid>
</Window>
